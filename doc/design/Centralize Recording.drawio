<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.9 Chrome/128.0.6613.186 Electron/32.2.5 Safari/537.36" version="26.0.9" pages="10">
  <diagram name="Requirement Spec" id="_erV0qfHDfpxdSzYlTd0">
    <mxGraphModel dx="2589" dy="822" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Nul5SpouegWZHrHkI-S2-1" value="Actor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="143" width="50" height="78" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-2" value="&lt;span style=&quot;text-wrap: wrap;&quot;&gt;Search Record&lt;/span&gt;" style="shape=ellipse;container=1;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;html=1;dashed=0;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="320" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-23" value="&lt;span style=&quot;text-wrap: wrap;&quot;&gt;Media Playback Control&lt;/span&gt;" style="shape=ellipse;container=1;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;html=1;dashed=0;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="320" y="240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-25" value="&lt;div&gt;- Identifiers: Call ID, Agent ID/Name, Extension Number, Agent Group/Queue, and Customer Identifier (Account Number/Case ID).&lt;/div&gt;&lt;div&gt;- Telephony Data: Dialed Number (DNIS), Caller ID (ANI), and Route/Trunk information.&lt;/div&gt;&lt;div&gt;- Time &amp;amp; Duration: Date range, specific time brackets, and call duration (e.g., calls longer than 5 minutes or shorter than 10 seconds).&lt;/div&gt;&lt;div&gt;- Call Disposition &amp;amp; Context: Wrap-up/disposition codes (e.g., &quot;Sales Closed&quot;, &quot;Complaint&quot;), call direction (Inbound/Outbound/Internal), and transfer/conference flags.&lt;/div&gt;&lt;div&gt;- Advanced Indexing: Search by custom data tags passed from a CRM or Case Management system via API.&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;align=left;size=30;position=0.13;position2=0;fontSize=8;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="410" y="30" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-27" value="&lt;div&gt;- Standard Transport Controls: Play, pause, stop, fast-forward, and rewind.&lt;/div&gt;&lt;div&gt;- Speed Control: Adjustable playback speed (e.g., 0.5x to 2.0x) without altering the pitch, allowing evaluators to scan calls faster.&lt;/div&gt;&lt;div&gt;- Visual Waveform Display: A visual representation of the audio amplitudes. This helps users quickly identify silences, holds, or periods where both parties are speaking at once (cross-talk).&lt;/div&gt;&lt;div&gt;- Stereo/Channel Separation: Ability to isolate or mute specific channels (e.g., listening only to the agent or only to the customer in a dual-channel recording).&lt;/div&gt;&lt;div&gt;- Looping &amp;amp; Bookmarking: Selecting a specific segment of the call to repeat continuously, or adding time-stamped digital notes/bookmarks for future reference.&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;align=left;size=30;position=0.13;position2=0;fontSize=8;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="460" y="170" width="670" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-28" value="Security, Compliance &amp;amp; Lifecycle Management" style="shape=ellipse;container=1;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;html=1;dashed=0;collapsible=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="320" y="360" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-30" value="Export &amp;amp; Sharing Capabilities" style="shape=ellipse;container=1;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;html=1;dashed=0;collapsible=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="320" y="480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-32" value="&lt;span style=&quot;text-align: left;&quot;&gt;Modern Extensions&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-align: left;&quot;&gt;(AI-Driven Add-ons)&lt;/span&gt;&lt;/div&gt;" style="shape=ellipse;container=1;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;html=1;dashed=0;collapsible=0;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="320" y="600" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-34" value="&lt;font&gt;- Role-Based Access Control (RBAC): Restricting who can search, play, download, or delete recordings based on their user role (e.g., Agent, Supervisor, Compliance Officer).&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;- Audit Trail / Logging: A comprehensive, unalterable log capturing who searched for, accessed, played, exported, or emailed any recording, including timestamps and IP addresses.&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;- PCI-DSS Compliance Handling: Automatic or manual muting/masking of audio during periods when sensitive data (like credit card numbers or CVVs) is collected.&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;- Legal Hold: The ability to flag specific recordings to exempt them from standard automated deletion schedules due to ongoing legal or compliance disputes.&lt;/font&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;align=left;size=30;position=0.13;position2=0;fontSize=8;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="460" y="290" width="640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-35" value="&lt;div&gt;- Multi-Format Export: Downloading the audio file in standard formats (such as encrypted or raw WAV, MP3, or MP4 for screen-capture variations).&lt;/div&gt;&lt;div&gt;- Secure Sharing Links: Generating temporary, password-protected, or expiring URLs to let external auditors or clients listen to a specific call without granting them access to the entire system.&lt;/div&gt;&lt;div&gt;- Bulk Export: Selecting multiple filtered calls to export simultaneously for external storage or migration purposes.&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;align=left;size=30;position=0.13;position2=0;fontSize=8;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="460" y="410" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Nul5SpouegWZHrHkI-S2-36" value="&lt;div&gt;- Speech-to-Text Transcription: Viewing a synchronized text script alongside the audio playback.&lt;/div&gt;&lt;div&gt;- Keyword Spotting: Searching for specific phrases (e.g., &quot;cancel my subscription&quot; or &quot;supervisor&quot;) directly within the audio timeline.&lt;/div&gt;&lt;div&gt;- Sentiment Analysis: Filtering calls based on detected emotional states (e.g., identifying calls with high customer frustration).&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;align=left;size=30;position=0.13;position2=0;fontSize=8;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="459" y="550" width="491" height="69" as="geometry" />
        </mxCell>
        <UserObject label="&lt;table data-sheets-baot=&quot;1&quot; data-sheets-root=&quot;1&quot; border=&quot;1&quot; dir=&quot;ltr&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; xmlns=&quot;http://www.w3.org/1999/xhtml&quot; style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; table-layout: fixed; font-size: 10pt; font-family: Arial; width: 0px; border-collapse: collapse; border: none;&quot;&gt;&lt;colgroup style=&quot;forced-color-adjust: none;&quot;&gt;&lt;col width=&quot;19&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;col width=&quot;547&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;/colgroup&gt;&lt;tbody style=&quot;forced-color-adjust: none;&quot;&gt;&lt;tr style=&quot;forced-color-adjust: none; height: 21px;&quot;&gt;&lt;td style=&quot;forced-color-adjust: none; overflow: hidden; padding: 2px 3px; vertical-align: bottom;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;forced-color-adjust: none; overflow: hidden; padding: 2px 3px; vertical-align: bottom; font-size: 12pt; font-weight: bold;&quot;&gt;Voice Transcription Features&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" link="&lt;table data-sheets-baot=&quot;1&quot; data-sheets-root=&quot;1&quot; border=&quot;1&quot; dir=&quot;ltr&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; xmlns=&quot;http://www.w3.org/1999/xhtml&quot; style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-transform: none; widows: 2; word-spa